datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                Int                  @id @default(autoincrement())
  email             String               @unique
  password          String
  name              String
  joinedAt          DateTime             @default(now())
  streak            Int                  @default(0)
  totalXp           Int                  @default(0)
  masteryWriting    Int                  @default(0)
  masteryVocabulary Int                  @default(0)
  dailyTargetKanji  Int                  @default(5)
  avatar            String               @default("https://lh3.googleusercontent.com/aida-public/AB6AXuCiQe5kqkxQSznu5qP6MOCvqYEImp869C8EXKrPH0xqE-mSavCz012Q0MTtSiFiePGaV02jEkiMUlPH1dLTj1avEShwCtSPBlbHOZxnVTLhGL0HVhU5xknHCCYedJb-IxKOpMgxpKK-Ow5sIgWFUsyyY7_E-KIuwiPB5-20LhiSP8pqZauZlFtFZIf2EzIHFf1ANexPscHZGB71rWIQwJNpU7zy75AnxMohpp66viSQtkCUk07SBp5f7FtlpU8V_ukuBsXxmpoldEg")
  role              String               @default("USER") // "USER" or "ADMIN"
  
  activities        UserActivity[]
  modules           UserModuleProgress[]
  kanjiProgress     UserKanjiProgress[]
}

model UserActivity {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         DateTime @default(now())
  kanjiCount   Int      @default(0)
  vocabCount   Int      @default(0)
  xpEarned     Int      @default(0)
  activityType String   // "LESSON", "REVIEW", "ACHIEVEMENT"
  description  String
}



model Module {
  id                 Int                  @id @default(autoincrement())
  title              String
  tujuanPembelajaran String?
  userProgress       UserModuleProgress[]
  kanjis             Kanji[]
}

model UserModuleProgress {
  userId          Int
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleId        Int
  module          Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  isCompleted     Boolean @default(false)
  isLocked        Boolean @default(false)
  progressPercent Int     @default(0)

  @@id([userId, moduleId])
}

model Kanji {
  id             Int                 @id @default(autoincrement())
  character      String              @unique // e.g. "情報"
  romaji         String
  meaning        String
  isJukugo       Boolean             @default(false)
  border         String?             // e.g. "border-l-4 border-secondary"
  
  moduleId       Int?
  module         Module?             @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  
  examples       ExampleSentence[]
  userProgress   UserKanjiProgress[]
  graphNodes     KanjiGraphNode[]
  graphEdges     KanjiGraphEdge[]
  etymologies    Etymology[]
  jukugos        Jukugo[]
}

model UserKanjiProgress {
  userId         Int
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kanjiId        Int
  kanji          Kanji    @relation(fields: [kanjiId], references: [id], onDelete: Cascade)
  masteryPercent Int      @default(0)
  status         String   @default("LEARNING") // "MASTERED", "LEARNING", "REVIEW"
  mistakeCount   Int      @default(0)
  lastPracticed  DateTime @default(now())

  @@id([userId, kanjiId])
}

model ExampleSentence {
  id          Int    @id @default(autoincrement())
  kanjiId     Int
  kanji       Kanji  @relation(fields: [kanjiId], references: [id], onDelete: Cascade)
  japanese    String
  romaji      String
  translation String
}



model KanjiGraphNode {
  id          String   @id // e.g. "root", "top-1"
  kanjiId     Int
  kanjiRef    Kanji    @relation(fields: [kanjiId], references: [id], onDelete: Cascade)
  character   String   // "情", "報"
  meaning     String
  type        String   // "root", "top", "bottom", "sub-bottom"
  borderColor String?
  isPill      Boolean  @default(false)
  parentPill  String?
}

model KanjiGraphEdge {
  id       String @id // e.g. "e-top1-root"
  kanjiId  Int
  kanjiRef Kanji  @relation(fields: [kanjiId], references: [id], onDelete: Cascade)
  source   String
  target   String
}

model Etymology {
  id        Int    @id @default(autoincrement())
  kanjiId   Int
  kanji     Kanji  @relation(fields: [kanjiId], references: [id], onDelete: Cascade)
  character String
  romaji    String
  detail    String
}

model Jukugo {
  id          Int    @id @default(autoincrement())
  kanjiId     Int
  kanji       Kanji  @relation(fields: [kanjiId], references: [id], onDelete: Cascade)
  word        String
  reading     String
  meaning     String
}

