generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int                  @id @default(autoincrement())
  email             String               @unique
  password          String
  name              String
  joinedAt          DateTime             @default(now())
  streak            Int                  @default(0)
  totalXp           Int                  @default(0)
  masteryWriting    Int                  @default(0)
  masteryVocabulary Int                  @default(0)
  dailyTargetKanji  Int                  @default(5)
  avatar            String               @default("https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&w=150&h=150")
  role              String               @default("USER")
  SubmissionComment SubmissionComment[]
  TaskComment       TaskComment[]
  TaskSubmission    TaskSubmission[]
  activities        UserActivity[]
  kanjiProgress     UserKanjiProgress[]
  moduleProgress    UserModuleProgress[]
  refleksiData      RefleksiData[]
}

model MasterRefleksi {
  id           Int            @id @default(autoincrement())
  kanjiId      Int
  question     String         @db.Text
  kanji        Kanji          @relation(fields: [kanjiId], references: [id], onDelete: Cascade)
  refleksiData RefleksiData[]

  @@index([kanjiId], map: "MasterRefleksi_kanjiId_fkey")
}

model RefleksiData {
  id               Int             @id @default(autoincrement())
  userId           Int
  kanjiId          Int
  masterRefleksiId Int?
  question         String          @db.Text
  answer           String          @db.Text
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  kanji            Kanji           @relation(fields: [kanjiId], references: [id], onDelete: Cascade)
  masterRefleksi   MasterRefleksi? @relation(fields: [masterRefleksiId], references: [id], onDelete: SetNull)

  @@index([userId], map: "RefleksiData_userId_fkey")
  @@index([kanjiId], map: "RefleksiData_kanjiId_fkey")
  @@index([masterRefleksiId], map: "RefleksiData_masterRefleksiId_fkey")
}

model UserActivity {
  id           Int      @id @default(autoincrement())
  userId       Int
  date         DateTime @default(now())
  kanjiCount   Int      @default(0)
  vocabCount   Int      @default(0)
  xpEarned     Int      @default(0)
  activityType String
  description  String   @db.Text
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "UserActivity_userId_fkey")
}

model Module {
  id                 Int                  @id @default(autoincrement())
  title              String
  tujuanPembelajaran String?              @db.Text
  kanjis             Kanji[]
  Task               Task[]
  userProgress       UserModuleProgress[]
}

model UserModuleProgress {
  userId          Int
  moduleId        Int
  isCompleted     Boolean @default(false)
  isLocked        Boolean @default(false)
  progressPercent Int     @default(0)
  module          Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, moduleId])
  @@index([moduleId], map: "UserModuleProgress_moduleId_fkey")
}

model Kanji {
  id             Int                 @id @default(autoincrement())
  character      String              @unique
  romaji         String
  meaning        String              @db.Text
  bushuu         String?
  onyomi         String?
  kunyomi        String?
  baseMeaning    String?             @db.Text
  isJukugo       Boolean             @default(false)
  border         String?
  moduleId       Int?
  examples       ExampleSentence[]
  jukugos           Jukugo[]
  semanticRelations SemanticRelation[]
  quizzes           Quiz[]
  module            Module?             @relation(fields: [moduleId], references: [id])
  graphEdges     KanjiGraphEdge[]
  Task           Task[]
  userProgress   UserKanjiProgress[]
  masterRefleksi MasterRefleksi[]
  refleksiData   RefleksiData[]

  @@index([moduleId], map: "Kanji_moduleId_fkey")
}

model UserKanjiProgress {
  userId         Int
  kanjiId        Int
  masteryPercent Int      @default(0)
  writingPercent Int      @default(0)
  readingPercent Int      @default(0)
  quizPercent    Int      @default(0)
  status         String   @default("LEARNING")
  mistakeCount   Int      @default(0)
  lastPracticed  DateTime @default(now())
  kanji          Kanji    @relation(fields: [kanjiId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, kanjiId])
  @@index([kanjiId], map: "UserKanjiProgress_kanjiId_fkey")
}

model ExampleSentence {
  id          Int     @id @default(autoincrement())
  kanjiId     Int
  japanese    String
  romaji      String
  translation String  @db.Text
  isReading   Boolean @default(true)
  kanji       Kanji   @relation(fields: [kanjiId], references: [id], onDelete: Cascade)

  @@index([kanjiId], map: "ExampleSentence_kanjiId_fkey")
}



model KanjiGraphEdge {
  id        String  @id
  kanjiId   Int
  source    String
  target    String
  predicate String?
  kanjiRef  Kanji   @relation(fields: [kanjiId], references: [id], onDelete: Cascade)

  @@index([kanjiId], map: "KanjiGraphEdge_kanjiId_fkey")
}

model Jukugo {
  id                Int                @id @default(autoincrement())
  kanjiId           Int
  word              String
  reading           String
  meaning           String             @db.Text
  kanji             Kanji              @relation(fields: [kanjiId], references: [id], onDelete: Cascade)
  kategoriKanji     KategoriKanji[]
  semanticRelations SemanticRelation[]

  @@index([kanjiId], map: "Jukugo_kanjiId_fkey")
}

model KategoriKanji {
  id         Int            @id @default(autoincrement())
  categoryId Int
  jokugoId   Int
  jokugo     Jukugo         @relation(fields: [jokugoId], references: [id], onDelete: Cascade)
  category   MasterCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([jokugoId], map: "KategoriKanji_jokugoId_fkey")
  @@index([categoryId], map: "KategoriKanji_categoryId_fkey")
}

model MasterCategory {
  id            Int             @id @default(autoincrement())
  name          String          @unique
  description   String?         @db.Text
  createdAt     DateTime        @default(now())
  kategoriKanji KategoriKanji[]
}

model SemanticRelation {
  id         Int                    @id @default(autoincrement())
  kanjiId    Int
  jukugoId   Int?
  penjelasan String?                @db.Text
  kanjiRef   Kanji                  @relation(fields: [kanjiId], references: [id], onDelete: Cascade)
  jukugo     Jukugo?                @relation(fields: [jukugoId], references: [id], onDelete: Cascade)
  nodes      SemanticRelationNode[]

  @@index([kanjiId], map: "SemanticRelation_kanjiId_fkey")
  @@index([jukugoId], map: "SemanticRelation_jukugoId_fkey")
}

model SemanticRelationNode {
  id               Int              @id @default(autoincrement())
  semanticId       Int
  jokugo           String
  arti             String           @db.Text
  semanticRelation SemanticRelation @relation(fields: [semanticId], references: [id], onDelete: Cascade)

  @@index([semanticId], map: "SemanticRelationNode_semanticId_fkey")
}

model SubmissionComment {
  id             Int            @id @default(autoincrement())
  submissionId   Int
  userId         Int
  content        String         @db.Text
  createdAt      DateTime       @default(now())
  TaskSubmission TaskSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  User           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([submissionId], map: "SubmissionComment_submissionId_fkey")
  @@index([userId], map: "SubmissionComment_userId_fkey")
}

model Task {
  id             Int              @id @default(autoincrement())
  title          String
  description    String           @db.Text
  dueDate        DateTime?
  createdAt      DateTime         @default(now())
  moduleId       Int?
  kanjiId        Int?
  fileUrl        String?
  materialsData  String?          @db.Text
  Kanji          Kanji?           @relation(fields: [kanjiId], references: [id], onDelete: Cascade)
  Module         Module?          @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  TaskComment    TaskComment[]
  TaskSubmission TaskSubmission[]

  @@index([kanjiId], map: "Task_kanjiId_fkey")
  @@index([moduleId], map: "Task_moduleId_fkey")
}

model TaskComment {
  id        Int      @id @default(autoincrement())
  taskId    Int
  userId    Int
  content   String   @db.Text
  createdAt DateTime @default(now())
  Task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId], map: "TaskComment_taskId_fkey")
  @@index([userId], map: "TaskComment_userId_fkey")
}

model TaskSubmission {
  id                Int                 @id @default(autoincrement())
  taskId            Int
  userId            Int
  content           String              @db.Text
  submittedAt       DateTime            @default(now())
  grade             String?
  feedback          String?             @db.Text
  fileUrl           String?
  submissionLink    String?
  submissionType    String?             @default("text")
  SubmissionComment SubmissionComment[]
  Task              Task                @relation(fields: [taskId], references: [id], onDelete: Cascade)
  User              User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId], map: "TaskSubmission_taskId_fkey")
  @@index([userId], map: "TaskSubmission_userId_fkey")
}

model JobQueue {
  id           Int      @id @default(autoincrement())
  jobType      String
  payload      String   @db.Text
  status       String   @default("PENDING")
  attempts     Int      @default(0)
  errorMessage String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Quiz {
  id            Int     @id @default(autoincrement())
  kanjiId       Int
  type          String  @default("multiple")
  question      String  @db.Text
  options       String? @db.Text
  correctAnswer String? @db.Text
  words         String? @db.Text
  correctOrder  String? @db.Text
  targetWord    String? @db.Text
  leftItems     String? @db.Text
  rightItems    String? @db.Text
  pairs         String? @db.Text
  groups        String? @db.Text
  explanation   String? @db.Text
  kanjiRef      Kanji   @relation(fields: [kanjiId], references: [id], onDelete: Cascade)

  @@index([kanjiId], map: "Quiz_kanjiId_fkey")
}

