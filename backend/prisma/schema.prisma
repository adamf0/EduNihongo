datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                Int                  @id @default(autoincrement())
  email             String               @unique
  password          String
  name              String
  joinedAt          DateTime             @default(now())
  streak            Int                  @default(0)
  totalXp           Int                  @default(0)
  masteryWriting    Int                  @default(0)
  masteryVocabulary Int                  @default(0)
  dailyTargetKanji  Int                  @default(5)
  avatar            String               @default("https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&w=150&h=150")
  role              String               @default("USER") // "USER" or "ADMIN"
  
  activities        UserActivity[]
  modules           UserModuleProgress[]
  kanjiProgress     UserKanjiProgress[]
  submissions       Submission[]
  comments          Comment[]
}

model UserActivity {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         DateTime @default(now())
  kanjiCount   Int      @default(0)
  vocabCount   Int      @default(0)
  xpEarned     Int      @default(0)
  activityType String   // "LESSON", "REVIEW", "ACHIEVEMENT"
  description  String   @db.Text
}



model Module {
  id                 Int                  @id @default(autoincrement())
  title              String
  tujuanPembelajaran String?              @db.Text
  userProgress       UserModuleProgress[]
  kanjis             Kanji[]
  assignments        Assignment[]
  comments           Comment[]
}

model UserModuleProgress {
  userId          Int
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleId        Int
  module          Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  isCompleted     Boolean @default(false)
  isLocked        Boolean @default(false)
  progressPercent Int     @default(0)

  @@id([userId, moduleId])
}

model Kanji {
  id             Int                 @id @default(autoincrement())
  character      String              @unique // e.g. "情報"
  romaji         String
  meaning        String              @db.Text
  isJukugo       Boolean             @default(false)
  border         String?             // e.g. "border-l-4 border-secondary"
  
  moduleId       Int?
  module         Module?             @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  
  examples       ExampleSentence[]
  userProgress   UserKanjiProgress[]
  graphNodes     KanjiGraphNode[]
  graphEdges     KanjiGraphEdge[]
  etymologies    Etymology[]
  jukugos        Jukugo[]
  quizData       String?             @db.Text
  assignments    Assignment[]
  comments       Comment[]
}

model UserKanjiProgress {
  userId         Int
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kanjiId        Int
  kanji          Kanji    @relation(fields: [kanjiId], references: [id], onDelete: Cascade)
  masteryPercent Int      @default(0)
  writingPercent Int      @default(0)
  readingPercent Int      @default(0)
  quizPercent    Int      @default(0)
  status         String   @default("LEARNING") // "MASTERED", "LEARNING", "REVIEW"
  mistakeCount   Int      @default(0)
  lastPracticed  DateTime @default(now())

  @@id([userId, kanjiId])
}

model ExampleSentence {
  id          Int     @id @default(autoincrement())
  kanjiId     Int
  kanji       Kanji   @relation(fields: [kanjiId], references: [id], onDelete: Cascade)
  japanese    String
  romaji      String
  translation String  @db.Text
  isReading   Boolean @default(false)
}



model KanjiGraphNode {
  id          String   @id // e.g. "root", "top-1"
  kanjiId     Int
  kanjiRef    Kanji    @relation(fields: [kanjiId], references: [id], onDelete: Cascade)
  character   String   // "情", "報"
  meaning     String
  type        String   // "root", "top", "bottom", "sub-bottom"
  borderColor String?
  isPill      Boolean  @default(false)
  parentPill  String?
}

model KanjiGraphEdge {
  id       String @id // e.g. "e-top1-root"
  kanjiId  Int
  kanjiRef Kanji  @relation(fields: [kanjiId], references: [id], onDelete: Cascade)
  source   String
  target   String
}

model Etymology {
  id        Int    @id @default(autoincrement())
  kanjiId   Int
  kanji     Kanji  @relation(fields: [kanjiId], references: [id], onDelete: Cascade)
  character String
  romaji    String
  detail    String @db.Text
}

model Jukugo {
  id          Int    @id @default(autoincrement())
  kanjiId     Int
  kanji       Kanji  @relation(fields: [kanjiId], references: [id], onDelete: Cascade)
  word        String
  reading     String
  meaning     String @db.Text
}

model Assignment {
  id          Int          @id @default(autoincrement())
  title       String
  description String       @db.Text
  dueDate     DateTime?
  createdAt   DateTime     @default(now())
  
  moduleId    Int?
  module      Module?      @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  
  kanjiId     Int?
  kanji       Kanji?       @relation(fields: [kanjiId], references: [id], onDelete: SetNull)
  
  submissions Submission[]
  comments    Comment[]
}

model Submission {
  id           Int        @id @default(autoincrement())
  assignmentId Int
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  
  userId       Int
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  content      String     @db.Text
  submittedAt  DateTime   @default(now())
  
  grade        String?    // e.g. A, B, 0-100
  feedback     String?    @db.Text
  
  comments     Comment[]
}

model Comment {
  id           Int         @id @default(autoincrement())
  userId       Int
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  content      String      @db.Text
  createdAt    DateTime    @default(now())
  
  moduleId     Int?
  module       Module?     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  
  kanjiId      Int?
  kanji        Kanji?      @relation(fields: [kanjiId], references: [id], onDelete: Cascade)
  
  assignmentId Int?
  assignment   Assignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  
  submissionId Int?
  submission   Submission? @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}