# Database Connection URL
DATABASE_URL="mysql://root:password@localhost:3306/edunihongo"

# JWT Secret
JWT_SECRET="edunihongo_secret_key"

# Port
PORT=5001

# Analytics Data Source Mode: 'mock' | 'real' | 'hybrid'
# 'mock'   = Uses realistic sample/demo dataset with full trial-and-error retries
# 'real'   = Uses live database calculation from endpoint (QuizAttempt, UserKanjiProgress, UserActivity)
# 'hybrid' = Calculates live DB metrics and supplements missing quadrant samples
ANALYTICS_DATA_SOURCE=mock
